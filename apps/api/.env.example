# Copy this file to .env and fill in the values.

# MongoDB Atlas connection string (Atlas → your cluster → Connect → Drivers).
# Add the database name "kestrel_demo" after ".net/" as shown.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/kestrel_demo?retryWrites=true&w=majority"

# Any long random strings. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="change-me"
# 64 hex characters (32 bytes). Encrypts card numbers and CVVs at rest.
CARD_ENCRYPTION_KEY="change-me-to-64-hex-characters"

# Email (admin Mail page). Any SMTP provider works, e.g.:
#   Gmail:  SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  (SMTP_PASS = an App Password, not your normal password)
#   Brevo:  SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# Leave SMTP_HOST empty to turn email off (messages are still saved and shown in the app).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Sterling Crest Bank <no-reply@example.com>"

PORT=4000
WEB_ORIGIN="http://localhost:5173"
